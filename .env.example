# Modèle des variables d'environnement du projet.
# Copier ce fichier en .env et remplir les valeurs sur son poste.
# Ne jamais mettre de vraie valeur ici : ce fichier est publié sur GitHub.
# En CI, les valeurs viennent des Secrets du dépôt GitHub.
# Variables à ajouter quand le fournisseur de modèle de langage sera choisi (ADR-0002).

# Diagnosis brick (src/agritech/diagnosis/README.md).
# Knowledge Flow address, to read the photos attached in Fred.
AGRITECH_KF_BASE_URL=
# Local folder of photos, used instead of Knowledge Flow (tests, H-T2 measures).
AGRITECH_PHOTO_DIR=
# Path of the model weights (default: src/agritech/diagnosis/weights/best.pt).
AGRITECH_DIAGNOSIS_MODEL=
# Bearer sent by scripts/measure_ht2.py when the tool reads from Knowledge Flow.
AGRITECH_MEASURE_TOKEN=
# iSDAsoil API account (src/agritech/data/isdasoil.py), registration at
# https://www.isda-africa.com/isdasoil/developer/.
AGRITECH_ISDASOIL_USERNAME=
AGRITECH_ISDASOIL_PASSWORD=
